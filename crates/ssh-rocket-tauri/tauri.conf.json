{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Rocket",
  "version": "2.0.0",
  "identifier": "io.github.idi0t.SshRocket",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH Rocket",
        "label": "main",
        "width": 960,
        "height": 650,
        "minWidth": 800,
        "minHeight": 550,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "title": "HUD",
        "label": "floating",
        "url": "/floating.html",
        "width": 240,
        "height": 80,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "SSH Rocket"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
