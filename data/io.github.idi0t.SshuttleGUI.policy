<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>1di0t</vendor>
  <vendor_url>https://github.com/1di0t/sshuttle-gui</vendor_url>

  <action id="io.github.idi0t.sshuttle.start">
    <description>Start sshuttle proxy tunnel</description>
    <message>Authentication is required to start sshuttle transparent proxy</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="io.github.idi0t.sshuttle.stop">
    <description>Stop sshuttle proxy tunnel</description>
    <message>Authentication is required to stop sshuttle transparent proxy</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
